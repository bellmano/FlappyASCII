{
  "name": "flappyascii",
  "version": "1.0.0",
  "description": "ASCII-based Flappy Bird game",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --globals --environment jsdom",
    "test:coverage": "vitest run --globals --environment jsdom --coverage --coverage.provider=istanbul --coverage.include=src/flappyascii.js --coverage.include=src/script.js --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.1.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
}
